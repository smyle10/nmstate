discover:
  how: fmf
prepare:
  - how: shell
    script: |
      cat << EOF > /etc/yum.repos.d/ovs.repo
      [ovs]
      name=ovs
      baseurl=https://download.devel.redhat.com/rhel-\$releasever/nightly/FDP/latest-FDP-\$releasever-RHEL-\$releasever/compose/Server/\$arch/os/
      enabled=1
      gpgcheck=0
      skip_if_unavailable=1
      sslverify=0
      EOF
  - how: install
    package:
      - nmstate
      - python3-pip
      - NetworkManager
      - NetworkManager-ovs
      - NetworkManager-libreswan
      - openvswitch$OVS_VER
      - python3-openvswitch$OVS_VER
      - hostapd
      - dnsmasq
      - python3-libnmstate
  - how: shell
    script: |
      pip install pytest
      systemctl enable openvswitch --now
execute:
  how: tmt
environment:
  OVS_VER: 3.1
provision:
  how: minute
  image: rhel9
report:
  - how: junit # in case the later method failed
    file: myjunit-20240924.xml
  - how: reportportal
    project: mshi_personal
    url: https://reportportal-rhelkernel.apps.ocp-c1.prod.psi.redhat.com
    # token: b243b1f5-117d-4048-be2c-9f2c5d9003fc
    launch: nmstate upstream
